# Kyoto Cycling API 環境変数設定
# このファイルを .env にコピーして、実際の値を設定してください

# Mapbox API アクセストークン（必須）
# 取得方法: https://account.mapbox.com/access-tokens/
MAPBOX_ACCESS_TOKEN=pk.your_mapbox_public_token_here

# デバッグ用エンドポイント（/debug/*）を有効にする（本番では設定しない）
# ENABLE_DEBUG_ENDPOINTS=true

# グラフファイルパス（オプション、デフォルト: app/data/graph/kyoto_bike_graph.pkl）
# GRAPH_PATH=app/data/graph/kyoto_bike_graph.pkl
